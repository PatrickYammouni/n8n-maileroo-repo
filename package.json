{
	"name": "n8n-nodes-maileroo",
	"version": "1.0.0",
	"description": "n8n community node for the Maileroo Email API",
	"license": "MIT",
	"homepage": "https://maileroo.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PatrickYammouni/n8n-maileroo-repo.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/PatrickYammouni/n8n-maileroo-repo/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"maileroo",
		"email"
	],
	"author": {
		"name": "Patrick Yammouni",
		"email": "patrickyammouni@gmail.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"predev": "node -e \"const major=+process.versions.node.split('.')[0]; if(major!==24){console.error('Current n8n needs Node 24. You are on '+process.version+'.\\nRun: export PATH=/opt/homebrew/opt/node@24/bin:$PATH'); process.exit(1)}\"",
		"dev": "N8N_EXPRESSION_ENGINE=legacy n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MailerooApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Maileroo/Maileroo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=24 <25"
	}
}
